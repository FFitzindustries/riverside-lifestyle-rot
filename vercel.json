{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node --test && node scripts/build.mjs",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/ink/",
      "destination": "https://www.riverside-ink.ch",
      "permanent": false
    },
    {
      "source": "/en/ink/",
      "destination": "https://www.riverside-ink.ch",
      "permanent": false
    },
    {
      "source": "/beauty/",
      "destination": "https://riverside-beauty.ch",
      "permanent": false
    },
    {
      "source": "/en/beauty/",
      "destination": "https://riverside-beauty.ch",
      "permanent": false
    },
    {
      "source": "/gastro/",
      "destination": "https://riverside-gastro.ch",
      "permanent": false
    },
    {
      "source": "/en/gastro/",
      "destination": "https://riverside-gastro.ch",
      "permanent": false
    },
    {
      "source": "/event/",
      "destination": "https://riverside-event.ch",
      "permanent": false
    },
    {
      "source": "/en/event/",
      "destination": "https://riverside-event.ch",
      "permanent": false
    }
  ]
}
